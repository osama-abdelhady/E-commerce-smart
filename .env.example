# ---- Database (matches docker-compose.yml) ----
ORACLE_SYS_PASSWORD=oracle_sys_password
DB_USERNAME=ecommerce_app
DB_PASSWORD=ecommerce_dev_password
DB_URL=jdbc:oracle:thin:@//localhost:1521/XEPDB1

# ---- JWT ----
# 256-bit+ random secret — generate with: openssl rand -base64 64
JWT_SECRET=

# ---- Stripe (test mode) ----
STRIPE_SECRET_KEY=sk_test_...
STRIPE_WEBHOOK_SECRET=whsec_...

# ---- Frontend origins (CORS) ----
# dev profile only — comma-separated if you're running more than one
# frontend origin locally (e.g. `ng serve` on :4200 AND the dockerized
# nginx frontend on :80 at the same time).
CORS_ALLOWED_ORIGINS=http://localhost:4200,http://localhost:80
STAGING_FRONTEND_URL=https://staging.tailoredplatform.dev
PROD_FRONTEND_URL=https://tailoredplatform.dev

# ---- Mail (order confirmations, password reset) ----
MAIL_HOST=
MAIL_PORT=587
MAIL_USERNAME=
MAIL_PASSWORD=
